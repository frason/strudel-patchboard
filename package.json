{
  "name": "strudel-patchboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build && node scripts/build-docs.mjs --out dist",
    "rubric": "node --import ./scripts/stub-loader.mjs scripts/rubric.mjs",
    "test": "node --import ./scripts/stub-loader.mjs scripts/verify.mjs && npm run test:reconcile && npm run test:guard && npm run handoff:check",
    "preview": "vite preview --port 4173",
    "test:import": "node --import ./scripts/stub-loader.mjs scripts/import-test.mjs",
    "test:reconcile": "node --import ./scripts/stub-loader.mjs scripts/reconcile-test.mjs",
    "test:guard": "node --import ./scripts/stub-loader.mjs scripts/guard-sweep.mjs",
    "perf": "node --import ./scripts/stub-loader.mjs scripts/perf.mjs",
    "handoff:list": "node scripts/handoff.mjs list",
    "handoff:check": "node scripts/handoff.mjs check",
    "handoff:new": "node scripts/handoff.mjs new",
    "handoff:context": "node scripts/handoff.mjs context",
    "handoff:fetch": "node scripts/handoff.mjs fetch",
    "handoff:index": "node scripts/handoff.mjs index",
    "docs": "node scripts/build-docs.mjs --out public",
    "perf:play": "node --import ./scripts/stub-loader.mjs scripts/perf-play.mjs",
    "bench:query": "node --import ./scripts/stub-loader.mjs scripts/bench-query.mjs",
    "bench:board": "node --import ./scripts/stub-loader.mjs scripts/bench-board.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.5",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/web": "^1.3.0",
    "acorn": "^8.19.0"
  },
  "devDependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "vite": "^8.3.8"
  },
  "license": "AGPL-3.0-or-later"
}
