// Made to Stray — recurring two-bar rhythm skeleton.
// Source: needle-707db0cd-488.wav; learned from 5 complete repeated phrases.
// Dry triangle clicks let the rhythm be heard without sample hiss or long tails.
// This is a rhythm audition, not an instrument reconstruction. Downbeat is conventional.

setcpm(129 / 4)

// Core accents
$: cat(
  note("f#4 ~ ~ ~ ~ ~ f#4 ~ ~ ~ ~ ~ ~ ~ ~ ~").s("triangle"),
  note("~ ~ ~ ~ ~ ~ f#4 ~ f#4 ~ ~ ~ ~ ~ ~ f#4").s("triangle")
)
  .decay(0.02).sustain(0).lpf(3500).gain(0.24)

// Stronger core accents
$: cat(
  note("~ ~ f#4 ~ ~ ~ ~ ~ f#4 ~ f#4 ~ ~ ~ ~ f#4").s("triangle"),
  note("f#4 ~ f#4 f#4 ~ ~ ~ ~ ~ ~ f#4 f#4 ~ ~ f#4 ~").s("triangle")
)
  .decay(0.02).sustain(0).lpf(3500).gain(0.29)

// Peak accents
$: cat(
  note("~ ~ ~ ~ f#4 ~ ~ ~ ~ ~ ~ ~ f#4 ~ ~ ~").s("triangle"),
  note("~ ~ ~ ~ f#4 ~ ~ ~ ~ ~ ~ ~ f#4 ~ ~ ~").s("triangle")
)
  .decay(0.02).sustain(0).lpf(3500).gain(0.36)

// Recurring faster attacks, kept quiet and at measured offsets.
// Closely spaced secondary peaks may be flams, echoes or ringing, not separate played notes.
// +0.117s within phrase — 16th-grid, recurring in 5 examples
$: cat(note("~ f#4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~").s("triangle"), note("~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~").s("triangle"))
  .late(0.000).decay(0.02).sustain(0).lpf(3500).gain(0.1)

